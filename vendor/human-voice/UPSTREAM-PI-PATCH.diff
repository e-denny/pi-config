+class InvariantCliTest(unittest.TestCase):
+    """check_invariants.py is what a shell-based agent runs when no MCP client exists."""
+
+    SRC = "p99 dropped from 340 ms to 120 ms. See https://example.com/runbook [3]."
+
+    def run_cli(self, argv):
+        buf = io.StringIO()
+        old, sys.stdout = sys.stdout, buf
+        try:
+            rc = check_invariants.main(argv)
+        finally:
+            sys.stdout = old
+        return rc, buf.getvalue()
+
+    def write(self, d, name, text):
+        path = os.path.join(d, name)
+        with open(path, "w", encoding="utf-8") as fh:
+            fh.write(text)
+        return path
+
+    def test_clean_pair_exits_zero(self):
+        with tempfile.TemporaryDirectory() as d:
+            rc, text = self.run_cli([self.write(d, "a.md", self.SRC),
+                                     self.write(d, "b.md", self.SRC)])
+        self.assertEqual(rc, 0)
+        self.assertIn("invariants: ok", text)
+
+    def test_lost_and_invented_exit_one(self):
+        bad = "Latency fell sharply, by 64%. See the runbook and [3]."
+        with tempfile.TemporaryDirectory() as d:
+            rc, text = self.run_cli([self.write(d, "a.md", self.SRC),
+                                     self.write(d, "b.md", bad)])
+        self.assertEqual(rc, 1)
+        self.assertIn("MISSING from the rewrite", text)
+        self.assertIn("INTRODUCED by the rewrite", text)
+        self.assertIn("restore missing spans verbatim", text)
+
+    def test_context_marks_added_numbers_as_sourced(self):
+        src = "Latency improved after the change."
+        out = "Latency fell from 340 ms to 120 ms after the change."
+        with tempfile.TemporaryDirectory() as d:
+            args = [self.write(d, "a.md", src), self.write(d, "b.md", out)]
+            changed, _ = self.run_cli(args)
+            sourced, text = self.run_cli(args[:1] + ["--context",
+                                                     self.write(d, "c.md", "p99 340 ms, now 120 ms")]
+                                        + args[1:])
+        self.assertEqual(changed, 1)
+        self.assertEqual(sourced, 0)
+        self.assertIn("invariants: ok", text)
+
+    def test_quiet_and_json_and_errors(self):
+        with tempfile.TemporaryDirectory() as d:
+            good = self.write(d, "a.md", self.SRC)
+            rc, text = self.run_cli(["--quiet", good, good])
+            self.assertEqual((rc, text.strip()), (0, "invariants: ok"))
+            rc, text = self.run_cli(["--json", good, good])
+            self.assertEqual(rc, 0)
+            self.assertEqual(json.loads(text)["status"], "ok")
+            rc, _ = self.run_cli([os.path.join(d, "missing.md"), good])
+            self.assertEqual(rc, 2)
+        with self.assertRaises(SystemExit):
+            check_invariants.main(["-", "-"])
+
